# Required local configuration
POSTGRES_DB=farmsra
POSTGRES_USER=farmsra
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
APP_BASE_URL=http://127.0.0.1:9000

# Local university prototype only; do not use as a production configuration
RAG_EDUCATIONAL_PROTOTYPE_MODE=true

# Optional Gemini and advisory configuration
# GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_ADVISORY_MODEL=gemini-3.5-flash-lite
GEMINI_ADVISORY_MAX_OUTPUT_TOKENS=2048
GEMINI_THINKING_LEVEL=low
GEMINI_CHAT_TIMEOUT=20
GEMINI_REWRITE_TIMEOUT=15
ADVISORY_JOB_STALE_AFTER_SECONDS=300

# Optional diagnosis and weather configuration
DIAGNOSIS_CONFIDENCE_THRESHOLD=0.70
CASE_WEATHER_AUTO_CAPTURE_MAX_AGE_MINUTES=30

# Optional SMTP email delivery
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=replace-with-smtp-username
# EMAIL_HOST_PASSWORD=replace-with-smtp-password
# EMAIL_USE_TLS=true
# EMAIL_TIMEOUT=10
# DEFAULT_FROM_EMAIL=FarmSra AI <no-reply@example.com>
