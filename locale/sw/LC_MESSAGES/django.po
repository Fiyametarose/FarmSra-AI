msgid "An account with this email address already exists."
msgstr "Akaunti yenye anwani hii ya barua pepe tayari ipo."

msgid ""
"Cannot change the species of a crop that has associated diagnosis cases."
msgstr "Huwezi kubadilisha aina ya zao lenye kesi za utambuzi zinazohusika."

msgid "Case location"
msgstr "Eneo la kesi"

msgid "Describe visible changes (optional)"
msgstr "Eleza mabadiliko yanayoonekana (hiari)"

msgid "Enter a valid email address and password."
msgstr "Ingiza barua pepe na nenosiri sahihi."

msgid "Outcome and findings are required and must be valid."
msgstr "Matokeo na matokeo ya uchunguzi yanahitajika na lazima yawe sahihi."

msgid "Planting date cannot be in the future."
msgstr "Tarehe ya kupanda haiwezi kuwa ya baadaye."

msgid "Select a registered crop (optional)"
msgstr "Chagua zao lililosajiliwa (hiari)"

msgid "The decoded image dimensions are too large."
msgstr "Vipimo vya picha iliyosimbuliwa ni vikubwa mno."

msgid "The image must be %(limit)s or smaller."
msgstr "Picha lazima iwe %(limit)s au ndogo zaidi."

msgid "This account is inactive."
msgstr "Akaunti hii haifanyi kazi."

msgid "Upload a valid, uncorrupted image."
msgstr "Pakia picha halali isiyoharibika."

msgid "Use a JPEG, PNG, or WebP image."
msgstr "Tumia picha ya JPEG, PNG, au WebP."

msgid "I understand that AI results are estimates, not confirmed diagnoses."
msgstr ""
"Ninaelewa kuwa matokeo ya AI ni makadirio, si utambuzi uliothibitishwa."

msgid "Case Reassigned"
msgstr "Kesi Imekabidhiwa Tena"

